# Copy to .env to override defaults. The project is fully functional with NONE of these set.

# LLM provider: "ollama" (default, local, free) | "replay" (bundled fixtures, offline) | "gemini" (optional) | "null" (no extraction)
RLX_PROVIDER=ollama

# Ollama (local, free). Model auto-falls-back if the preferred one is not pulled.
RLX_OLLAMA_URL=http://localhost:11434
RLX_OLLAMA_MODEL=qwen2.5:7b-instruct
RLX_OLLAMA_FALLBACK_MODEL=phi3:latest

# Optional Gemini free tier. Only used if RLX_PROVIDER=gemini. Never commit a real key.
# GEMINI_API_KEY=

# Optional local embeddings for fuzzy attribute linking (needs the 'embeddings' extra).
RLX_EMBEDDINGS=0

# Database + storage paths
RLX_DB=data/rlx.db
RLX_PDF_DIR=data/pdfs
RLX_PAGECACHE_DIR=data/pagecache
